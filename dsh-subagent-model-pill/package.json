{
  "name": "dsh-subagent-model-pill",
  "version": "1.2.0",
  "description": "DSH 独立插件：子代理会话的模型胶囊（显示当前模型 + 白名单切换，待命时也能换）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.5 <0.3.0"
  },
  "license": "MIT"
}
