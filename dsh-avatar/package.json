{
  "name": "dsh-avatar",
  "version": "1.0.0",
  "description": "DSH 独立插件：对话头像/昵称（消息流头像行 + 设置页「对话头像」面板）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5 <0.3.0",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.5 <0.3.0"
  },
  "license": "MIT"
}
